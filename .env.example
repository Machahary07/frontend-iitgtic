# Supabase — project URL and the browser-safe publishable key.
# Both are shipped to the client, so they must keep the PUBLIC_ prefix.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses RLS — used by the TIC admin routes to verify companies,
# delete accounts and read every posted job. Never give this a PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Server-only. Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it signs every admin out.
ADMIN_SESSION_SECRET=

# Server-only. Bootstrap password for /tic-admin. It only works while no admin
# account exists yet — it is the way the first admin is created, and stops
# granting access the moment one exists.
TIC_ADMIN_PASSWORD=

# Postgres password for the Supabase project. Only used by the Supabase CLI
# (`supabase db push`); the app itself never reads it.
IITG_SUPABASE_PASSWORD=

# Cloudflare Turnstile. The site key is public, the secret key is server-only.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — transactional email. Without RESEND_API_KEY the app still renders
# every message and records it in the console as blocked, so nothing breaks;
# it simply does not deliver.
RESEND_API_KEY=re_...

# The From address. Resend only delivers from a domain you have verified — the
# default sandbox sender (onboarding@resend.dev) reaches the account owner and
# nobody else, so set this before going live.
RESEND_FROM="IIT Guwahati TIC <no-reply@iitgtic.in>"
RESEND_REPLY_TO=tic@iitg.ac.in

# Which Resend plan the account is on: free | pro | scale | enterprise. It is
# what the usage meter counts against — free is 3,000 a month and 100 a day.
# Override the caps directly if the account has custom limits.
RESEND_PLAN=free
# RESEND_MONTHLY_LIMIT=3000
# RESEND_DAILY_LIMIT=100

# Absolute origin used for links inside emails, which have no request to infer
# it from. No trailing slash.
PUBLIC_SITE_URL=https://iitgtic.in
EMAIL_SITE_NAME=IIT Guwahati TIC
