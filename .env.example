# Supabase — project URL and the browser-safe publishable key.
# Both are shipped to the client, so they must keep the PUBLIC_ prefix.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Bypasses RLS — used by the TIC admin routes to verify companies,
# delete accounts and read every posted job. Never give this a PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Server-only. Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it signs every admin out.
ADMIN_SESSION_SECRET=

# Server-only. Bootstrap password for /tic-admin. It only works while no admin
# account exists yet — it is the way the first admin is created, and stops
# granting access the moment one exists.
TIC_ADMIN_PASSWORD=

# Postgres password for the Supabase project. Only used by the Supabase CLI
# (`supabase db push`); the app itself never reads it.
IITG_SUPABASE_PASSWORD=

# Cloudflare Turnstile. The site key is public, the secret key is server-only.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — transactional email. Without RESEND_API_KEY the app still renders
# every message and records it in the console as blocked, so nothing breaks;
# it simply does not deliver.
RESEND_API_KEY=re_...

# The From address. Resend only delivers from a domain verified on the account
# the API key belongs to. If left on Resend's sandbox sender
# (onboarding@resend.dev) it reaches only the account owner, nobody else.
#
# The quotes below belong to the .env syntax and are stripped when this file is
# read. They are NOT part of the value: pasting this line verbatim into the
# Vercel dashboard sets the sender to `"IIT Guwahati TIC <hello@iitgtic.com>"`
# with the quotes attached, which Resend rejects as a malformed `from`. In a
# dashboard, enter the value alone:
#
#     IIT Guwahati TIC <hello@iitgtic.com>
RESEND_FROM="IIT Guwahati TIC <hello@iitgtic.com>"

# Reply-to, and the inbox that admin sign-in / new-applicant alerts go to. Set
# ADMIN_ALERT_EMAIL explicitly — with both blank, those alerts fall back to the
# From address, which means they are addressed to the sender and read by nobody.
RESEND_REPLY_TO=
ADMIN_ALERT_EMAIL=

# Signing secret for the Resend webhook, from Resend → Webhooks after you add an
# endpoint pointing at https://<your site>/api/resend-webhook. Subscribe it to
# email.bounced and email.complained at minimum. Without this the endpoint
# refuses every request — an unsigned version would let anyone suppress any
# address. Starts with whsec_.
RESEND_WEBHOOK_SECRET=

# Which Resend plan the account is on: free | pro | scale | enterprise. It is
# what the usage meter counts against — free is 3,000 a month and 100 a day.
# Override the caps directly if the account has custom limits.
RESEND_PLAN=free
# RESEND_MONTHLY_LIMIT=3000
# RESEND_DAILY_LIMIT=100

# Absolute origin used for links inside emails, which have no request to infer
# it from. No trailing slash.
PUBLIC_SITE_URL=https://iitgtic.com
EMAIL_SITE_NAME=IIT Guwahati TIC

# Server-only, optional. The allowance the Storage console draws its meter
# against. Supabase does not report a plan's storage limit over the API, so this
# is configuration rather than a lookup. Defaults to 1 GB, the free plan's
# allowance — raise it when the project moves to a paid plan.
# SUPABASE_STORAGE_QUOTA_BYTES=1073741824

# Server-only, optional. Sarvam AI key for the admin assistant (/tic-admin/ai).
# Leave it unset and each admin pastes their own key into the assistant's
# settings dialog, where it is kept in their browser and never stored server
# side. Set it here instead to give the whole team one shared key.
#
# sarvam-105b works on any key. gemma4 — the model that reads images — is in
# beta and only answers for keys Sarvam has allow-listed for it.
# SARVAM_API_KEY=sk_...

# Server-only. Vercel Cron sends this as a bearer token to /api/cron/*. The daily
# resume clean-up (resumes deleted 90 days after a role ends) refuses to run
# without it. Generate like ADMIN_SESSION_SECRET.
CRON_SECRET=
