{
	"name": "iitgtic",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node --max-http-header-size=65536 node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "node --max-http-header-size=65536 node_modules/vite/bin/vite.js preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "node --test tests/content-schema.test.mjs tests/session-validation.test.mjs",
		"doctor": "node scripts/doctor.js",
		"backup": "node scripts/backup.js",
		"restore": "node scripts/restore.js"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^24",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"sass": "^1.99.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@fontsource-variable/montserrat": "^5.2.8",
		"@fontsource-variable/source-serif-4": "^5.2.9",
		"@lucide/svelte": "^1.16.0",
		"@supabase/supabase-js": "^2.106.1",
		"@vercel/analytics": "^2.0.1",
		"gsap": "^3.15.0",
		"ogl": "^1.0.11"
	}
}
